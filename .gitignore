# Dependency directory
# https://www.npmjs.org/doc/misc/npm-faq.html#should-i-check-my-node_modules-folder-into-git
node_modules
.yarn/*
!.yarn/releases
!.yarn/plugins
.pnp.*
.test_run
.vscode/
coverage/
# these two entries should not be necessary anymore, but remain for now to
# ensure these obsolete directories aren't commited if a clone still has them
/database/
/server
npm-debug.log
pnpm-debug.log
scratch/
*.scratch/
*.scratch.*
.angular
.DS_STORE
# this line must be last
!.gitkeep
