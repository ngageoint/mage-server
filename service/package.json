    "captcha-canvas": "3.4.0",
    "commander": "12.0.0",
    "express": "4.22.2",
    "express-session": "1.18.1",
    "file-type": "16.5.4",
    "fs-extra": "11.3.4",
    "geojson": "0.5.0",
    "geojson-validation": "1.0.2",
    "json2csv": "5.0.7",
    "jsonwebtoken": "9.0.2",
    "ldapts": "^8.1.8",
    "lodash": "4.18.1",
    "mgrs": "1.0.0",
    "mime-types": "2.1.35",
