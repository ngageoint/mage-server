  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ngageoint/mage-server/issues"
  },
  "homepage": "https://github.com/ngageoint/mage-server#readme",
  "dependencies": {
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "7.0.15",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@ngageoint/mage.service": "^6.5.8 || ^6.6.0-beta"
  }
